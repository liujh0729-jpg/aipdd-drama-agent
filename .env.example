# SuperTale / NovelVideo newAPI 环境变量示例
#
# 复制为 .env 后填写真实值。
# SuperTale 侧只配置 newAPI 网关、newAPI 逻辑模型名、参考媒体 relay 和运行环境参数。
# 上游渠道、真实模型、映射、价格和 token 权限在 newAPI 后台配置。


# =============================================================================
# 0. 任务信封签名（可选；单机部署留空即可）
# =============================================================================

# 任务信封用 HMAC 签名，防止任务在投递途中被改写身份。单机部署无需配置：
# 首次启动自动生成一把本机密钥，存放于 <NOVELVIDEO_STATE_DIR>/task_envelope_keyring.json
# （权限 0600），此后重启复用。
#
# 只有多主机共跑同一套任务时才需要显式配置——此时所有进程必须用同一份 keyring，
# 否则一端签的另一端验不过。生成一把 key：
#   python3 -c "import base64,os;print(base64.b64encode(os.urandom(32)).decode())"
# active key ID 须匹配 ^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$ 且存在于 keyring 中；
# keyring 可同时保留退役 key，供轮换窗口内验签。真实值只放本机或密钥管理系统。
ST_TASK_ENVELOPE_ACTIVE_KEY_ID=
ST_TASK_ENVELOPE_KEYRING_B64_JSON=


# =============================================================================
# [aipdd fork delta] CE 最小可用多用户隔离
# =============================================================================
# 总开关：true 后 CE 需登录（/api/v1/auth/login），项目按 owner 隔离；
# 默认 false 保持单用户免登录。docker-compose.aipdd.yml 已默认开启。
ST_CE_MULTI_USER=false
# 引导账户（首次启动自动创建，id=local）的用户名/口令。口令不设则启动时
# 生成随机值并打印一次 WARNING 日志；建议首次登录后自行调整。
ST_LOCAL_USERNAME=local
ST_LOCAL_PASSWORD=
# 自助注册默认关闭（需要时改 true）；会话 TTL 秒，默认 7 天。
ST_CE_ALLOW_SELF_REGISTER=false
ST_CE_SESSION_TTL_SECONDS=604800
# plain http 部署（如 :8080）必须设 false，否则浏览器不会回传登录 cookie。
ST_COOKIE_SECURE=true


# =============================================================================
# 1. newAPI 统一网关
# =============================================================================

# LocalNewAPI 后台宿主端口（仅 docker compose 生效）。容器内固定 3000，这里只改 宿主映射。
# 默认 3000；端口冲突时改成别的（例如 30000）。
# [aipdd fork delta] docker-compose.aipdd.yml 已不再映射该端口：网关只做项目内部的
# OpenAI 兼容传输层，对外统一走 web 的 /gateway/v1/ 出口（见下面的 NEWAPI_PUBLIC_BASE_URL）。
# 本项只对上游 docker-compose.yml / docker-compose.release.yml 生效。
# ST_NEWAPI_PORT=3000

# 镜像来源与版本（仅镜像模式 docker-compose.release.yml 生效）。默认拉 Docker Hub 上 claymorelab/* 的固定版本
# （见文件内默认值，每次发行包打包后由打包 workflow 开 PR 抬，不是 latest）。
# 国内拉取慢可切到阿里云 ACR 公开仓；ACR 只有发行包钉过的 tag，没有 latest，三行要一起填：
# DRAMACLAW_IMAGE_PREFIX=claymore-registry.cn-chengdu.cr.aliyuncs.com/dramaclaw
# DRAMACLAW_VERSION=2.0.2
# DRAMACLAW_GATEWAY_VERSION=v1.0.0-rc.24-dramaclaw.1
# 网关后台端口默认只绑本机回环；要从别的机器访问网关后台时放开：
# [aipdd fork delta] aipdd 编排不再暴露该端口（网关后台不对外），仅上游编排生效。
# ST_NEWAPI_BIND=0.0.0.0
# 源码构建（docker compose up -d --build）默认用与本仓并排的 ../dramaclaw-gateway checkout 构建网关（先 git clone 它）；
# clone 放在别处、或不想 clone 而让 Docker 直接从 git 拉时改这里：
# DRAMACLAW_GATEWAY_SRC=../dramaclaw-gateway
# DRAMACLAW_GATEWAY_SRC=https://github.com/dramaclaw/dramaclaw-gateway.git#main

# 官方渠道在网页「设置 → 模型配置 → 官方渠道」填写 DC key。
# 本地渠道使用 CE 随附的 LocalNewAPI，并由配置向导自动创建运行 token。
# 两种渠道的运行地址和 token 均保存在本机 settings.db，不从环境变量读取。

# CE LocalNewAPI 配置向导。数据库固定使用本机 SQLite，无需填写 DSN 或路径。
NEWAPI_PROVISIONER_ENABLED=true

# LocalNewAPI 管理地址，不带 /v1；用于 /api/channel/ 和 /api/token/ 管理接口。
# [aipdd fork delta req41] 不预填主机名：compose 部署已注入容器网络内的服务名
# （NEWAPI_ADMIN_BASE_URL=http://newapi:3000，无需你填）；只有「宿主机源码跑 api +
# 网关另起在一处」时才需要填你自己那个网关的管理地址。
# NEWAPI_ADMIN_BASE_URL=

NEWAPI_PROVISIONER_INIT_TIMEOUT_MS=120000
NEWAPI_RELAY_TOKEN_NAME=dramaclaw-ce-runtime

# 是否让 newAPI 文本模型客户端读取系统代理。默认 true。
# 本地 Surge 系统代理影响内网 newAPI 时可设为 false。
# NEWAPI_TEXT_TRUST_ENV=false

# newAPI 文本模型 HTTP 超时时间，单位秒。
NEWAPI_TEXT_TIMEOUT_SECONDS=300

# 请求路径同步 LLM 端点（改写/故事优化/故事转剧本/Seedance2 提示词）的总墙钟超时，
# 单位秒。底层单次 HTTP 调用各有 read timeout，但一次生成可能多轮往返；这是防单个
# 卡住的生成无限期占住 worker 的安全网兜底——只在病态挂起触发并返回 504，正常生成远
# 低于此值。缺省/非法/非正值一律回落到内置宽松默认 900。别设太紧以免误杀合法多步生成。
# LLM_REQUEST_DEADLINE_SECONDS=900

# [aipdd fork delta] WP-B: 上游模型清单与别名一致性自检的 TTL 缓存（秒）。
# 前者给“保存前校验目标是否存在”用，后者给 /config 健康位用；填 0 = 每次重算。
NEWAPI_UPSTREAM_MODELS_TTL_SECONDS=600
NEWAPI_ALIAS_HEALTH_TTL_SECONDS=900

# [aipdd fork delta] 上游模型「是否真开通 / 真能用」的最小实测（一次 chat、max_tokens=1）。
# 火山方舟 GET /models 返回平台全量目录，账号没开通的名字也在清单里，选中就在调用时
# 404 InvalidEndpointOrModel.NotFound；工具页 / 画布的文本与视觉候选因此按实测结论
# 收敛：只有上游明确判了「未开通 / 无权限」的名字才摘出候选；限流、鉴权失败、超时
# 等拿不准的一律保留。实测在候选目录被读取时后台幂等触发，不阻塞响应，不打印凭据。
# 文本与视觉各自一轮、各一份缓存：视觉实测发的是**带一张极小图片**的请求（文本 ping
# 通不代表能读图），额外多一档 not-vision（上游明说读不了图）也会被摘出候选。
# MODEL_PROBE_ENABLED=0 可整体关掉（回到「清单即候选」的旧行为）；
# MODEL_PROBE_TTL_HOURS 控制同一渠道的重测间隔（默认 24 小时）。
# 旧名 TEXT_MODEL_PROBE_ENABLED / TEXT_MODEL_PROBE_TTL_HOURS 继续兼容（已部署环境
# 不动配置也能升），MODEL_PROBE_* 存在时以它为准。
# TEXT_MODEL_PROBE_ENABLED=1
# TEXT_MODEL_PROBE_TTL_HOURS=24
MODEL_PROBE_ENABLED=1
MODEL_PROBE_TTL_HOURS=24

# [aipdd fork delta] 模型广场调用示例里对外可复制的网关地址。本项只是**展示示例**
# 用的对外入口，不改实际路由，也不猜主机名：留空时由当前请求的 Host 推导
# （用户能打开这个页面，就说明该 origin 对他可达；对外出口固定是 /gateway/v1）。
# 宿主机端口不是默认值、从局域网另一台机器调用、或走域名反代时显式填：
#   NEWAPI_PUBLIC_BASE_URL=http://<宿主机IP>:<ST_WEB_PORT>/gateway/v1
#   NEWAPI_PUBLIC_BASE_URL=https://你的域名/gateway/v1
# NEWAPI_PUBLIC_BASE_URL=

# 官方媒体目录默认使用本 fork 仓内自带的 official_media_models.json（不回调上游 DramaClaw 基建）。
# 仅当你显式配置下面的同步源时才会联网；autoUpdate 默认关闭，不自动轮询。
# OFFICIAL_MEDIA_CATALOG_MANIFEST_URL=
# 后端自动更新轮询间隔，最低 60 秒，默认 300 秒。
# OFFICIAL_MEDIA_CATALOG_POLL_SECONDS=300
# 兼容旧部署：直接返回目录 JSON 的地址。未配置 manifest 时才使用。
# 默认读取本 fork（liujh0729-jpg/aipdd-drama-agent）main 分支中的目录文件。
# OFFICIAL_MEDIA_CATALOG_URL=https://raw.githubusercontent.com/liujh0729-jpg/aipdd-drama-agent/main/src/novelvideo/official_media_models.json

# Hermes / 虾导聊天模型。地址和密钥始终跟随当前选中的模型网关。
HERMES_MODEL=DC-hermes-LLM
HERMES_MODEL_API_MODE=chat_completions
HERMES_MODEL_CONTEXT_LENGTH=131072


# =============================================================================
# 2. newAPI 参考媒体 OSS relay
# =============================================================================

# 本地参考图需要先上传到 OSS relay，再把短期签名 URL 传给 newAPI/上游。
# CE 前端保存 OSS relay 配置后，本地 SQLite 配置优先生效。
MEDIA_RELAY_PROVIDER=aliyun_oss

# 签名 URL 默认有效期，单位秒。CE 前端保存后，本地 SQLite 配置优先生效。
MEDIA_RELAY_TTL_SECONDS=1800

# relay bucket 固定给 newAPI 参考媒体使用。CE 前端保存后，本地 SQLite 配置优先生效。
OSS_RELAY_ENDPOINT=oss-cn-chengdu.aliyuncs.com
OSS_RELAY_BUCKET=claymore-llm-relay
OSS_RELAY_AK=
OSS_RELAY_SK=

# 可选：使用 Cloudinary 作为参考媒体 relay。将 MEDIA_RELAY_PROVIDER 设为 cloudinary 后生效。
CLOUDINARY_RELAY_CLOUD_NAME=
CLOUDINARY_RELAY_API_KEY=
CLOUDINARY_RELAY_API_SECRET=
CLOUDINARY_RELAY_FOLDER=

# 可选：使用 AWS S3（或任意 S3 兼容对象存储）作为参考媒体 relay。
# 将 MEDIA_RELAY_PROVIDER 设为 aws_s3 后生效；CE 前端「AIPDD 数字资产云/本地存储」
# 保存的配置优先生效，下面这组 env 只是未在前端填写时的兜底。凭据留空即不启用。
AWS_S3_REGION=
AWS_S3_BUCKET=
AWS_S3_ENDPOINT_URL=
AWS_S3_ACCESS_KEY_ID=
AWS_S3_SECRET_ACCESS_KEY=
AWS_S3_SESSION_TOKEN=

# [aipdd fork delta req44] AIPDD 参考媒体中转（设置页「本地存储」与「AIPDD 数字资产云」两档共用）。
# 上传口 POST {站点根}/oss/upload 用的就是 X-API-Key：填 AIPDD 渠道自己的密钥即可，无需另申请。
# 优先级：设置页填写 > 下面这组 env > 已连接的 AIPDD 渠道；留空且没连渠道时，参考视频/音频发不出去。
AIPDD_CLOUD_BASE_URL=
AIPDD_CLOUD_API_KEY=
# 对象前缀（可选，留空用 assets/dramaclaw）与「上传后是否同时登记为数字资产」。
AIPDD_CLOUD_PREFIX=
AIPDD_CLOUD_REGISTER_ASSET=false

# [aipdd fork delta] 画布视频「高清」= 火山引擎 AI MediaKit 生成式超分（可选）。
# 在 AI MediaKit 控制台创建 API Key；未配置则高清回退本地 ffmpeg。
# 也可在设置页填写（DB 配置优先于以下环境变量）。
# VIDEO_ENHANCE_BACKEND: auto(配了就走 MediaKit、失败回退 ffmpeg) | mediakit | ffmpeg
VIDEO_ENHANCE_BACKEND=auto
MEDIAKIT_API_KEY=
MEDIAKIT_BASE_URL=https://mediakit.cn-beijing.volces.com/api/v1

# [aipdd fork delta] 工具页「抖音/音视频提取文案」的豆包语音 ASR 凭证（openspeech
# 单 API Key）只在设置页 VolcEngine 渠道卡填写（设置 DB 是唯一真源），不走环境变量。


# =============================================================================
# 3. Cognee 知识图谱
# =============================================================================

# 导入小说 / cognify / memify 使用的 LLM。
COGNEE_LLM_MODEL=DC-cognee-LLM

# 跳过 Cognee 启动连接预检，真实请求仍会走 newAPI。
COGNEE_SKIP_CONNECTION_TEST=true

# Cognee 启动和旧路径使用的默认模型名。项目实际请求模型由各自
# project_config.json 的 cognee_embedding_model 决定：官方历史项目使用 v1，
# 官方新项目使用 v2，CE 自定义 newAPI 项目使用无后缀兼容模型名。
COGNEE_EMBEDDING_MODEL=DC-cognee-embedding
# Cognee 启动和无项目上下文旧路径的默认维度。项目实际维度由
# project_config.json 的 cognee_embedding_dimension 决定。
COGNEE_EMBEDDING_DIM=1024

# 每次小说导入 pipeline 的上游在途请求上限。多个同时导入的 pipeline 会分别计算。
# LLM 的实体/关系抽取与摘要共享同一个并发额度。
COGNEE_LLM_CONCURRENCY=2

# structured_v1 逐片段抽取的并发槽位（角色抽取、场次规范化、场景描述生成）。
STRUCTURED_LLM_CONCURRENCY=2
# Embedding 并发限制当前仅适用于经 newAPI/custom LiteLLM 发出的请求；其他 provider 会记录绕过日志。
COGNEE_EMBEDDING_BATCH_CONCURRENCY=4

# Cognee embedding 单次请求文本条数。官方默认使用 10，兼容 Qwen / 阿里等低 input 上限模型。
# 如果上游 embedding 模型支持更大批量，可以按需调高。
EMBEDDING_BATCH_SIZE=10

# =============================================================================
# 4. newAPI 文本模型
# =============================================================================

# 镜头页 / AI 优化提示词。
GLOBAL_VIDEO_OPTIMIZER_MODEL=DC-video-prompt-optimizer-LLM

# 镜头页 / Seedance 2.0 面板 / AI 优化。
SEEDANCE2_PROMPT_COMPOSER_MODEL=DC-seedance2-prompt-composer-LLM

# 草图 / AI 检测身份与道具颜色标记。
GLOBAL_VIDEO_IDENTITY_DETECTOR_MODEL=DC-video-identity-detector-LLM

# 剧集详情 / AI 规划身份 / 出场角色筛选。
IDENTITY_PLANNER_CAST_MODEL=DC-identity-cast-planner-LLM

# 剧集详情 / AI 规划身份 / 默认身份与其他身份分析。
IDENTITY_PLANNER_ANALYSIS_MODEL=DC-identity-analysis-planner-LLM

# 剧集详情 / AI 规划身份 / 新身份服装造型描述。
IDENTITY_PLANNER_APPEARANCE_MODEL=DC-identity-appearance-writer-LLM

# 剧集详情 / 逐行生成。
LITERAL_BEAT_META_MODEL=DC-literal-beat-meta-LLM

# 场景库 / 从图谱构建 / 场景解析、规范化与 environment_prompt 生成。
SCENE_BUILD_MODEL=DC-scene-builder-LLM

# 角色库 / 从原文构建 / structured_v1 逐片段角色抽取与证据引用。
CHARACTER_BUILD_MODEL=DC-character-builder-LLM

# 剧集详情 / 规划场景。
EPISODE_SCENE_PLANNER_MODEL=DC-episode-scene-planner-LLM

# 剧集详情 / 规划道具。
EPISODE_PROP_PLANNER_MODEL=DC-episode-prop-planner-LLM

# Freezone / 文本提示词中英互译。
FREEZONE_TRANSLATION_MODEL=DC-freezone-translator-LLM

# Freezone / AI 文本创作。
FREEZONE_TEXT_WRITER_MODEL=DC-freezone-text-writer-LLM

# Freezone / 故事脚本生成。
FREEZONE_STORY_SCRIPT_MODEL=DC-freezone-story-script-writer-LLM

# Freezone / 图片反推、视频参考生分镜和局部元素识别；必须支持图片输入。
FREEZONE_VISION_MODEL=DC-freezone-vision-LLM

# Freezone 画布 payload 上限，单位字节。
FREEZONE_CANVAS_PAYLOAD_LIMIT_BYTES=5242880

# 画布风格图墙。清单随包发布（src/novelvideo/freezone/style_templates.json），
# 但 45 套风格的封面和示例图不随仓库发布 —— ASSET_BASE 必须指向一个 OSS/CDN 前缀，
# 前端按 `<base>/<清单里的相对路径>` 拼绝对地址。留空则图墙只显示占位块，
# 风格名/提示词/筛选都照常可用（后端启动后首次下发清单时会 WARNING 提示）。
# 图片可用 scripts/build_style_gallery.py 自行构建。
# 注意：下面那行是占位示例，不能直接照抄。自建部署换成自己的域名后，还要把该域名
# 加进前端 CSP 的 img-src 白名单（frontend/docker/nginx.conf.template），否则浏览器
# 会拦掉所有封面，表现和没配一样是一墙占位块。
# 想换一套风格库而不重新发版：图片传新前缀后改 ASSET_BASE，清单另存一处后用
# MANIFEST 指过去。两者互相独立，可以只改其中一个。
#STYLE_GALLERY_ASSET_BASE=https://cdn.example.com/style-gallery
#STYLE_GALLERY_MANIFEST=/etc/dramaclaw/style_templates.json

# 风格页 / 上传参考图创建自定义风格。
STYLE_ANALYZER_MODEL=DC-style-analyzer-LLM

# 内容改写 / 原文转短视频口播逐行文本。
CONTENT_REWRITER_MODEL=DC-content-rewriter-LLM

# 导演分镜编剧（DirectorWorld 剧本生成）。
DIRECTOR_SCREENWRITER_MODEL=DC-director-screenwriter-LLM

# 剧本规范化。
SCREENPLAY_NORMALIZER_MODEL=DC-screenplay-normalizer-LLM

# 2.0 资产编译 / 基础场景资产校对。
EPISODE_SCENE_RECONCILE_MODEL=DC-episode-scene-reconciler-LLM

# 2.0 资产编译 / 解说剧场景资产规划。
NARRATED_SCENE_ASSET_MODEL=DC-narrated-scene-asset-planner-LLM

# DirectorWorld / Freezone AI 临时道具规划。
STAGING_PROP_MODEL=DC-staging-prop-planner-LLM
STAGING_PROP_TIMEOUT_SECONDS=120

# 剧本 → 场景头自动补全（结构化输出；utils/scene_header_autogen.py）。
# 官方默认 DC-hermes-LLM；想让这一步单独跑在网关里另一个模型上就覆盖本项。
SCENE_HEADER_AUTOGEN_MODEL=DC-hermes-LLM

# 默认组合的代表位（只用于状态回显；各 per-feature *_MODEL 覆盖优先于它）。
# [req40] 这里写的名字必须来自「设置 › 模型」同步出来的渠道目录，系统不再预设
# 任何模型名。留空 = 回显走下面的兜底 / 槽位绑定链。
# 网关按「渠道::模型」复合调用名路由，同名模型挂在多个渠道时裸名不再注册，
# 因此建议写复合名，形如 {provider}::{catalogModel}。
NEWAPI_TEXT_MODEL=

# 全局文本兜底（解析顺序的第二层）：per-feature env → 本项 → 「设置 › 模型」里
# 给该槽位绑定的模型（绑定目标下架会自动取消）。三条都不成立 = 提交前 400，
# 系统绝不回到任何预设模型名。留空 = 不启用这一层。
TEXT_MODEL_FALLBACK=

# 视觉理解类任务的全局兜底（图片输入类：图片反推、局部元素识别等）。
# 只能指向渠道目录里声明可读图（或实测判为 ok）的模型；留空 = 不启用这一层，
# 各功能回到自己的 per-feature env / 槽位绑定，解析不到即提交前 400。
VISION_MODEL_FALLBACK=


# =============================================================================
# 5. newAPI 图片模型
# =============================================================================

# LingShan-G2 逻辑模型；image2 类模型会按场景透传 quality。
NEWAPI_IMAGE_MODEL=LingShan-G2

# LingShan-NB-2 逻辑模型；nano-banana/nb 类模型不透传 quality。
NEWAPI_NANOBANANA2_MODEL=LingShan-NB-2

# 角色图默认模型。
DEFAULT_CHARACTER_IMAGE_SELECTION=newapi_gpt_image2

# 镜头草图默认模型。
DEFAULT_SKETCH_IMAGE_SELECTION=newapi_gpt_image2

# 镜头 render 默认模型。
DEFAULT_RENDER_IMAGE_SELECTION=newapi_gpt_image2

# 项目资产 / 道具三视图参考图 reference_3view.png。
PROP_REF_IMAGE_PROVIDER=newapi
PROP_REF_IMAGE_MODEL=LingShan-G2

# 项目资产 / 源图 master.png，纯文本生成。
SCENE_MASTER_IMAGE_PROVIDER=newapi
SCENE_MASTER_IMAGE_MODEL=LingShan-NB-2

# 项目资产 / reverse_master.png，使用 master.png 作为参考图。
SCENE_REVERSE_MASTER_IMAGE_PROVIDER=newapi
SCENE_REVERSE_MASTER_IMAGE_MODEL=LingShan-NB-2

# 项目资产 / pano_360.png，使用 master/reverse 参考图，2:1 全景。
SCENE_360_IMAGE_PROVIDER=newapi
SCENE_360_IMAGE_MODEL=LingShan-G2


# =============================================================================
# 6. 图像基础参数
# =============================================================================

IMAGE_DEFAULT_WIDTH=1440
IMAGE_DEFAULT_HEIGHT=2560
IMAGE_DEFAULT_STYLE=chinese_period_drama


# =============================================================================
# 7. newAPI 视频模型
# =============================================================================

# 默认视频生成后端。
# [aipdd fork delta req41] 不预填具体模型名：渠道目录才是视频模型名的真源（req40）。
# ``newapi`` = 走网关，具体模型由「设置 › 模型」绑定的视频槽位决定；
# 需要钉住某个后端时再写 ``VIDEO_BACKEND=newapi_<你的目录里的模型名>``。
VIDEO_BACKEND=newapi

# 下面四项都是 **EE 官方网关随包清单 / 运维覆盖项**：CE（自有渠道）下候选只来自
# 渠道目录 + 「设置 › 模型」勾选，把具体模型名写在模板里等于替所有部署预置一份
# 可}␀能已下架的名字。默认注释掉，需要时自行取消注释并按你网关实际情况填。
# 页面可选的 newAPI 视频模型（EE 随包清单）。
# NEWAPI_VIDEO_MODELS=

# 默认视频模型（留空=不兜底，由视频槽位决定）。
# DEFAULT_VIDEO_MODEL=
# NEWAPI_VIDEO_MODEL=

# 默认视频分辨率。
NEWAPI_VIDEO_RESOLUTION=720p

# auto 表示按模型和 beat 类型决定是否生成同步音频。
NEWAPI_VIDEO_GENERATE_AUDIO=auto

# 支持 generate_audio 的视频模型（按已选中模型名派生的运营参数）。
# NEWAPI_VIDEO_AUDIO_MODELS=

# 各视频模型允许的 duration 范围，单位秒（同上，未命中时用各后端的通用默认区间）。
# NEWAPI_VIDEO_DURATION_BOUNDS=


# =============================================================================
# 8. newAPI 音频模型
# =============================================================================

# beat 音频生成使用 IndexTTS2；参考声线按 v2.0 逻辑传入。
INDEXTTS2_NEWAPI_MODEL=index-tts-2

# 音频生成 HTTP 超时时间，单位秒。
INDEXTTS2_TIMEOUT_SECONDS=1800


# =============================================================================
# 9. 视频基础参数
# =============================================================================

VIDEO_FPS=30
VIDEO_WIDTH=1080
VIDEO_HEIGHT=1920
VIDEO_CODEC=libx264
VIDEO_AUDIO_CODEC=aac
VIDEO_BITRATE=4M


# =============================================================================
# 10. UI 配置
# =============================================================================


# BuilderGPT Director viewer 对浏览器可访问的地址。
# [aipdd fork delta req41] 留空=不启用导演台（代码不再兜底本机 9024，也不会猜主机名）。
# 需要时填你的部署实际对外地址：本机开发 http://127.0.0.1:9024，
# 局域网协作 http://192.168.2.206:9024，域名反代 https://your-domain。
DIRECTOR_VIEWER_URL=

# operator 操作口令：护「导出提示词」与「图像生成防护闸」。
# 必须设为你自己的非默认值；留空 = 这些受护动作一律拒绝(无公开默认口令)。
PROMPT_EXPORT_PASSWORD=change_me

# 版本/功能更新通知。false = 完全关闭 release feed,不读包内 notes、不访问 GitHub。
RELEASE_NOTIFICATIONS_ENABLED=true

# 可选 GitHub token,用于提高 GitHub releases/latest 查询限流额度；留空走匿名请求。
RELEASE_NOTIFICATIONS_GITHUB_TOKEN=


# =============================================================================
# 11. 数据目录
# =============================================================================

# output、state、runtime 默认都从 NOVELVIDEO_DATA_ROOT 派生。
# 本地默认使用当前目录；Docker Compose 固定使用持久化卷 /data。
# 如需整体迁移数据目录，请配置一个绝对路径。
# NOVELVIDEO_DATA_ROOT=

# 高级覆盖：通常无需单独配置；Docker Compose 会强制使用 /data/output。
# NOVELVIDEO_OUTPUT_DIR=


# =============================================================================
# 12. [aipdd fork delta] 宿主 Chrome 与本地 Agent 工具
# =============================================================================

# 客户自带 Chrome 的调试端口（内置「Chrome MCP」与抖音文案提取共用；不下载任何
# 浏览器二进制）。Chrome 必须【以调试端口启动】；日常 Chrome 已在运行时，
# `open -a "Google Chrome" --args --remote-debugging-port=9222` 的 flag 会被现有进程忽略，
# 且默认 profile 不开放调试端口。正解是用仓库脚本（独立 profile ~/.chrome-douyin-cdp）：
#   bash scripts/douyin-cdp-chrome.sh --background   # 弹出的窗口不能关
# 自检：宿主机 `curl -s localhost:9222/json/version` 有输出即就绪。
# Docker 部署默认经 host.docker.internal 访问宿主机 Chrome；非 Docker 部署改
# http://127.0.0.1:9222。docker-compose.aipdd.yml 已默认传入，通常无需填写。
# ST_CHROME_CDP_URL=http://host.docker.internal:9222

# 本机 Blender MCP（内置「Blender MCP」）插件 socket 地址：Blender 侧装 BlenderMCP
# 插件并点「Start MCP Server」。Docker 部署默认 host.docker.internal:9876（与 Chrome
# 同法），本机部署可设 ST_BLENDER_HOST=localhost；ST_BLENDER_TIMEOUT 为转发超时（秒）。
# docker-compose.aipdd.yml 已默认传入，通常无需填写。
# ST_BLENDER_HOST=host.docker.internal
# ST_BLENDER_PORT=9876
# ST_BLENDER_TIMEOUT=30

# MCP 栏目「本地 Agent 工具」的探测根：compose 把 ${HOME} 挂进容器 /host-home，
# 据此检测并把 aipdd-drama 条目写进宿主 ~/.claude.json、~/.codex/config.toml 等
# 工具配置（写入前备份 .bak）。docker-compose.aipdd.yml 固定为 /host-home，
# 本机直跑服务时可显式指向真实 home。
# HOST_HOME_PATH=/host-home

# [aipdd fork delta] 「本地 Agent 工具」应用本体探测根：compose 默认把宿主
# /Applications 只读挂进容器，非默认挂载路径时显式覆盖。
# HOST_APPS_PATH=/host-apps

# [aipdd fork delta] IndexTTS2 音频 API 直连模式的 host 命中词（默认 aipdd）：
# 配置的声音服务 baseUrl 命中该 host 片段即走宿主直连协议。
# AIPDD_AUDIO_API_HOST_HINT=aipdd

# [aipdd fork delta] 「应用本体」级安装证据：compose 默认把宿主 /Applications
# （macOS）只读挂进容器 /host-applications，用于区分真安装与卸载残留（如
# /Applications/Cursor.app 是否存在），避免仅凭配置目录把历史残留显示成
# 「已安装」。非 macOS 可改指向本系统的应用目录，或指向任一已存在目录以避免
# 在多机部署时创建空目录。Colima（Lima）用户需先执行
#   colima stop && colima start --mount ~:w --mount /Applications
# 使 VM 内可见 /Applications（--mount 为替换语义，须同时保留 ~ 挂载）。
# HOST_APPS_DIR=/Applications

# [aipdd fork delta] AIPDD Drama MCP 接入（品牌改名后的对外变量名）：外部
# MCP 客户端（Claude Code / Cursor / Codex 等）连内置 aipdd-drama stdio 服务器时
# 注入以下变量；旧名 DRAMACLAW_* / SUPERTALE_* 继续作为回退生效，无需迁移。
# 变量名与 MCP 栏目「接入指南」页展示的一致，一般写在 mcp.json 的 env 里，
# 不需要进 .env；列在此处仅供直跑/编排注入时查阅。
# AIPDD_DRAMA_API_URL=http://127.0.0.1:8780
# AIPDD_DRAMA_AGENT_TOKEN=st-xxxx
# AIPDD_DRAMA_PROJECT_ID=
# AIPDD_DRAMA_API_TIMEOUT_SECONDS=120
# AIPDD_DRAMA_PROJECT_OUTPUT_DIR=
# 原生/便携部署（无 nginx）时由后端直接伺服 SPA：指向前端构建产物目录才挂载。
# AIPDD_DRAMA_FRONTEND_DIST=
