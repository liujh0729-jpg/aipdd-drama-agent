# File path: /etc/systemd/system/localapi.service
# sudo systemctl daemon-reload
# sudo systemctl start localapi
# sudo systemctl enable localapi
# sudo systemctl status localapi
[Unit]
Description=LocalAPI Service
After=network.target

[Service]
User=ubuntu  # 注意修改用户名
WorkingDirectory=/path/to/localapi  # 注意修改路径
ExecStart=/path/to/localapi/localapi --port 3000 --log-dir /path/to/localapi/logs  # 注意修改路径和端口号
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
